  &amp;amp;lt;!-- =====================================================================
       BLOK 3: JAVASCRIPT LOGIC (ANTI-BLOKIR MUROTAL YOUTUBE + MP3, CRUD &amp;amp;amp; GAS)
       ===================================================================== --&amp;amp;gt;
  &amp;amp;lt;script&amp;amp;gt;
    const STORAGE_KEY = 'SIMTAQ_MAN2_ABULYATAMA_DB_V5';
    const isGasEnvironment = () =&amp;amp;gt; typeof google !== 'undefined' &amp;amp;amp;&amp;amp;amp; google.script &amp;amp;amp;&amp;amp;amp; google.script.run;

    // State Utama Aplikasi (Daftar Putar Murotal Mendukung Link YouTube &amp;amp;amp; MP3)
    let appState = {
      currentUser: null,
      activeDashTab: 'tab-overview',
      playlist: [
