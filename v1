    function showToast(msg, type = 'success') {
      const container = document.getElementById('toastContainer');
      if (!container) return;
      const item = document.createElement('div');
      const color = type === 'success' ? 'bg-emerald-700' : type === 'error' ? 'bg-rose-600' : 'bg-sky-700';
      item.className = `${color} text-white px-4 py-3 rounded-2xl shadow-xl text-xs font-bold flex items-center space-x-2 pointer-events-auto`;
      item.innerHTML = `&amp;lt;i class="fa-solid fa-circle-check"&amp;gt;&amp;lt;/i&amp;gt;&amp;lt;span&amp;gt;${msg}&amp;lt;/span&amp;gt;`;
      container.appendChild(item);
      setTimeout(() =&amp;gt; item.remove(), 3200);
    }

    function persistLocalState() {
      try {
        const copy = {
          playlist: appState.playlist,
          santri: appState.santri,
          ustadz: appState.ustadz,
          setoran: appState.setoran,
          target: appState.target,
          pejabat: appState.pejabat
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(copy));
      } catch (e) {}
    }

    function loadInitialData() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.playlist?.length) appState.playlist = parsed.playlist;
          if (parsed.santri?.length) appState.santri = parsed.santri;
          if (parsed.ustadz?.length) appState.ustadz = parsed.ustadz;
          if (parsed.setoran?.length) appState.setoran = parsed.setoran;
          if (parsed.target?.length) appState.target = parsed.target;
          if (parsed.pejabat) appState.pejabat = { ...appState.pejabat, ...parsed.pejabat };
        }
      } catch (e) {}

      if (isGasEnvironment()) {
        setElHTML('syncStatusBadge', '&amp;lt;span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"&amp;gt;&amp;lt;/span&amp;gt; Memuat Google Sheet...');
        google.script.run.withSuccessHandler(res =&amp;gt; {
          if (res) {
            if (res.playlist?.length) appState.playlist = res.playlist;
            if (res.santri?.length) appState.santri = res.santri;
            if (res.ustadz?.length) appState.ustadz = res.ustadz;
            if (res.setoran?.length) appState.setoran = res.setoran;
            if (res.target?.length) appState.target = res.target;
            if (res.pejabat &amp;amp;&amp;amp; Object.keys(res.pejabat).length) {
              appState.pejabat = { ...appState.pejabat, ...res.pejabat };
            }
            persistLocalState();
            refreshAllViews();
            renderPlaylistUI();
            setElHTML('syncStatusBadge', '&amp;lt;span class="w-2 h-2 rounded-full bg-emerald-400"&amp;gt;&amp;lt;/span&amp;gt; Terhubung Spreadsheet &amp;amp; Drive');
          }
        }).getAllSimtaqData();
      }
    }

