  const target = read('Target_Hafalan').map(r =&amp;gt; ({ id: r[0], santriId: r[1], nis: r[2], santriNama: r[3], kelas: r[4], target: r[5], tanggalTarget: r[6], status: r[7] || 'Proses' }));
