    // Login &amp;amp; Hak Akses
    let currentLoginRole = 'ortu';
    function openLoginModal() {
      document.getElementById('loginModal').classList.remove('hidden');
      switchLoginRole(currentLoginRole);
    }
    function openLoginWithRole(role) {
      currentLoginRole = role;
      openLoginModal();
    }
    function closeLoginModal() {
      document.getElementById('loginModal').classList.add('hidden');
    }

    function switchLoginRole(role) {
      currentLoginRole = role;
      ['ortu', 'ustadz', 'admin'].forEach(r =&amp;gt; {
        const btn = document.getElementById('roleBtn' + r.charAt(0).toUpperCase() + r.slice(1));
        if (btn) {
          btn.className = r === role
            ? 'py-2.5 rounded-xl bg-white text-emerald-800 shadow-xs transition font-extrabold'
            : 'py-2.5 rounded-xl text-slate-600 transition font-bold';
        }
      });

      const input = document.getElementById('loginInputVal');
      if (role === 'ortu') {
        setElText('loginLabelText', 'NIS Santri (Nomor Induk Siswa)');
        if (input) input.value = appState.santri[0]?.nis || '4334345';
        setElHTML('loginHintText', 'Masukkan NIS putra/putri Anda (Contoh: &amp;lt;strong&amp;gt;4334345&amp;lt;/strong&amp;gt;)');
        setElText('roleSubmitName', 'Orang Tua');
      } else if (role === 'ustadz') {
        setElText('loginLabelText', 'NIP / Nama Ustadz atau Ustadzah');
        if (input) input.value = appState.ustadz[0]?.nip || '198201012005011001';
        setElHTML('loginHintText', 'Masukkan NIP atau Nama Ustadz/Ustadzah pembimbing');
        setElText('roleSubmitName', 'Ustadz/Ustadzah');
      } else {
        setElText('loginLabelText', 'Kode Akses Administrator');
        if (input) input.value = 'admin2026';
        setElHTML('loginHintText', 'Kode akses standar Admin: &amp;lt;strong&amp;gt;admin2026&amp;lt;/strong&amp;gt;');
        setElText('roleSubmitName', 'Admin');
      }
    }

    function handleLoginSubmit(e) {
      e.preventDefault();
      const val = document.getElementById('loginInputVal').value.trim();

      if (currentLoginRole === 'ortu') {
        const s = appState.santri.find(x =&amp;gt; String(x.nis) === String(val));
        if (!s) {
          showToast('NIS Santri tidak ditemukan!', 'error');
          return;
        }
        appState.currentUser = { role: 'ortu', name: 'Orang Tua (' + s.nama + ')', nis: s.nis, santriId: s.id };
      } else if (currentLoginRole === 'ustadz') {
        const u = appState.ustadz.find(x =&amp;gt; x.nip === val || x.nama.toLowerCase().includes(val.toLowerCase())) || appState.ustadz[0];
        appState.currentUser = { role: 'ustadz', name: u ? u.nama : 'Ustadz/Ustadzah Pembimbing', nis: '' };
      } else {
        if (val !== 'admin2026' &amp;amp;&amp;amp; val !== 'admin') {
          showToast('Kode akses Admin salah! Gunakan: admin2026', 'error');
          return;
        }
        appState.currentUser = { role: 'admin', name: 'Administrator SIMTAQ', nis: '' };
      }

      closeLoginModal();
      applyUserPermissions();
      switchView('dashboard');
      switchDashTab('tab-overview');
      refreshAllViews();
      showToast('Selamat datang, ' + appState.currentUser.name);
    }

    function applyUserPermissions() {
      const role = appState.currentUser?.role || null;
      const isAdmin = role === 'admin';

      if (appState.currentUser) {
        setElText('welcomeUserText', 'Selamat Datang, ' + appState.currentUser.name);
        setElText('userRoleBadge', isAdmin ? 'Administrator' : role === 'ustadz' ? 'Ustadz / Ustadzah' : 'Orang Tua Santri');
        setElText('welcomeSubText',
          role === 'ortu'
            ? 'Pantau progres hafalan, rekaman video setoran, dan rapor putra/putri Anda.'
            : role === 'ustadz'
              ? 'Kelola input setoran hafalan, rekam video santri, dan evaluasi target.'
              : 'Hak akses penuh manajemen Santri, Ustadz/Ustadzah, Link YouTube Murotal, Pimpinan, dan GAS.'
        );
      }

      const show = (id, cond) =&amp;gt; {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('hidden', !cond);
      };

      show('btnQuickSetoran', isAdmin || role === 'ustadz');
      show('btnQuickMusic', isAdmin);
      show('btnQuickPejabat', isAdmin);
      show('btnAddSantri', isAdmin);
      show('btnAddUstadz', isAdmin);
      show('btnSetoranTabAction', isAdmin || role === 'ustadz');
      show('btnAddTarget', isAdmin || role === 'ustadz');

      // Tombol Kelola Murotal di Panel Audio Atas hanya untuk Admin
      show('btnAdminManageMusic', isAdmin);
      show('btnDrawerAddMusic', isAdmin);

      if (appState.currentUser) {
        setElHTML('authHeaderContainer', `
          &amp;lt;div class="flex items-center space-x-1.5"&amp;gt;
            &amp;lt;span class="hidden sm:inline text-xs font-extrabold text-emerald-800 bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-200"&amp;gt;${appState.currentUser.name}&amp;lt;/span&amp;gt;
            &amp;lt;button onclick="handleLogout()" class="px-3 py-2 rounded-xl bg-rose-50 text-rose-700 text-xs font-extrabold border border-rose-200 hover:bg-rose-100" title="Keluar"&amp;gt;&amp;lt;i class="fa-solid fa-power-off"&amp;gt;&amp;lt;/i&amp;gt;&amp;lt;/button&amp;gt;
          &amp;lt;/div&amp;gt;
        `);
      }

      renderNavigationMenus();
    }

    function handleLogout() {
      appState.currentUser = null;
      applyUserPermissions();
      setElHTML('authHeaderContainer', `
        &amp;lt;button onclick="openLoginModal()" class="px-3.5 py-2 rounded-xl bg-brand-gradient text-white text-xs font-extrabold shadow-sm hover:opacity-95 transition flex items-center space-x-1.5"&amp;gt;
