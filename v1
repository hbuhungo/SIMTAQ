      overflow-x: hidden;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Kelas Utilitas Visibilitas &amp; Transisi Halus */
    .hidden {
      display: none !important;
    }
    .fade-out {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      transition: opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.65s ease;
    }
    .fade-in {
      animation: simtaqFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes simtaqFadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Desain Welcome Screen Imersif */
    .welcome-screen {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      background: radial-gradient(circle at top right, rgba(2, 132, 199, 0.35), transparent 55%),
                  radial-gradient(circle at bottom left, rgba(16, 185, 129, 0.35), transparent 55%),
                  linear-gradient(135deg, #042f1a 0%, #064e3b 48%, #0c4a6e 100%);
      color: #ffffff;
      opacity: 1;
      visibility: visible;
      transition: opacity 0.65s ease, visibility 0.65s ease;
    }
    .welcome-card {
      width: 100%;
      max-width: 520px;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 1.75rem;
      padding: 2rem 1.5rem;
      text-align: center;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.55);
    }

    /* Tipografi Elegan SIMTAQ */
    .bg-brand-gradient {
      background: linear-gradient(135deg, #0f6832 0%, #0d9488 50%, #0284c7 100%);
    }
    .simtaq-brand-title {
      font-family: 'Outfit', sans-serif;
      letter-spacing: 0.04em;
      background: linear-gradient(135deg, #0f6832 0%, #059669 45%, #0284c7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 1px 1px rgba(15, 104, 50, 0.08));
    }
    .simtaq-welcome-title {
      font-family: 'Outfit', sans-serif;
      letter-spacing: 0.06em;
      background: linear-gradient(135deg, #ffffff 0%, #a7f3d0 50%, #bae6fd 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Styling Panel Kontrol Murotal &amp; Slider Volume */
    .audio-controller-wrapper {
      background: linear-gradient(90deg, #0f172a 0%, #064e3b 50%, #0c4a6e 100%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .volume-slider {
      -webkit-appearance: none;
      appearance: none;
      height: 6px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.25);
      outline: none;
      cursor: pointer;
    }
    .volume-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #10b981;
      border: 2px solid #ffffff;
      cursor: pointer;
      box-shadow: 0 1px 4px rgba(0,0,0,0.4);
    }

    /* Animasi Indikator Gelombang Suara Murotal */
    .eq-bar {
      display: inline-block;
      width: 3px;
      background-color: #34d399;
      border-radius: 2px;
      animation: eqBounce 1s infinite ease-in-out;
    }
    .eq-bar:nth-child(2) { animation-delay: 0.2s; }
    .eq-bar:nth-child(3) { animation-delay: 0.4s; }
    .eq-paused .eq-bar { animation-play-state: paused; height: 4px !important; }
    @keyframes eqBounce {
      0%, 100% { height: 4px; }
      50% { height: 13px; }
    }

    /* Kontainer YouTube Player Tersembunyi / Mini Preview */
    .yt-hidden-frame {
      position: fixed;
      bottom: -9999px;
      right: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }
    .yt-visible-frame {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      width: 280px;
      height: 158px;
      z-index: 60;
      border-radius: 1rem;
      overflow: hidden;
      border: 2px solid #10b981;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
      background: #000;
    }

    @media print {
      header, footer, .no-print, .welcome-screen, .audio-controller-wrapper, #ytWrapperBox {
        display: none !important;
      }
      body {
        background: #ffffff !important;
      }
    }
