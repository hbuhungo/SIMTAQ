    function handleSaveSantri(e) {
      e.preventDefault();
      const id = document.getElementById('editSantriId').value || ('SNT-' + Date.now());
      const obj = {
        id,
        nama: document.getElementById('formSantriNama').value.trim(),
        nis: document.getElementById('formSantriNis').value.trim(),
        jk: document.getElementById('formSantriJk').value,
        kelas: document.getElementById('formSantriKelas').value.trim(),
        juz: Number(document.getElementById('formSantriJuz').value),
        asrama: document.getElementById('formSantriAsrama').value.trim(),
        status: document.getElementById('formSantriStatus').value
      };

      const idx = appState.santri.findIndex(x =&amp;amp;gt; x.id === id);
      if (idx &amp;amp;gt;= 0) {
        appState.santri[idx] = obj;
        appState.setoran.forEach(st =&amp;amp;gt; { if (st.santriId === id) { st.santriNama = obj.nama; st.nis = obj.nis; } });
        appState.target.forEach(tg =&amp;amp;gt; { if (tg.santriId === id) { tg.santriNama = obj.nama; tg.nis = obj.nis; tg.kelas = obj.kelas; } });
      } else {
        appState.santri.push(obj);
      }

      persistLocalState();
      if (isGasEnvironment()) google.script.run.upsertSantriGAS(obj);
      closeSantriModal();
      refreshAllViews();
      showToast('Data santri berhasil disimpan!');
    }

    function deleteSantri(id) {
      appState.santri = appState.santri.filter(x =&amp;amp;gt; x.id !== id);
      persistLocalState();
      if (isGasEnvironment()) google.script.run.deleteRecordByIdGAS('Data_Santri', id);
