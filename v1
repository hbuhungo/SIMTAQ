    function refreshAllViews() {
      const isOrtu = appState.currentUser?.role === 'ortu';
      const activeSantri = isOrtu ? appState.santri.filter(s =&amp;gt; s.nis === appState.currentUser.nis) : appState.santri;
      const activeSetoran = isOrtu ? appState.setoran.filter(s =&amp;gt; s.nis === appState.currentUser.nis) : appState.setoran;
      const activeTarget = isOrtu ? appState.target.filter(t =&amp;gt; t.nis === appState.currentUser.nis) : appState.target;

      const avg = activeSetoran.length
        ? (activeSetoran.reduce((acc, cur) =&amp;gt; acc + Number(cur.nilai || 0), 0) / activeSetoran.length).toFixed(1)
        : '0.0';

      setElText('statSantriCount', appState.santri.length);
      setElText('statUstadzCount', appState.ustadz.length);
      setElText('statSetoranCount', appState.setoran.length);
      setElText('statAvgScore', avg);

      setElText('pubSantri', appState.santri.length);
      setElText('pubUstadz', appState.ustadz.length);
      setElText('pubSetoran', appState.setoran.length);
      setElText('pubAvg', avg);

      setElText('dashCardSantri', activeSantri.length);
      setElText('dashCardUstadz', appState.ustadz.length);
      setElText('dashCardSetoran', activeSetoran.length);
      setElText('dashCardAvgNilai', avg);
      setElText('dashCardTargetSelesai', activeTarget.filter(t =&amp;gt; t.status === 'Selesai').length);
      setElText('dashCardVideoCount', activeSetoran.filter(s =&amp;gt; s.hasVideo).length);

      const lancar = activeSetoran.filter(s =&amp;gt; s.nilai &amp;gt;= 90).length;
      const cukup = activeSetoran.filter(s =&amp;gt; s.nilai &amp;gt;= 75 &amp;amp;&amp;amp; s.nilai &amp;lt; 90).length;
      const perbaikan = activeSetoran.filter(s =&amp;gt; s.nilai &amp;lt; 75).length;
      setElText('countLancar', lancar);
      setElText('countCukup', cukup);
      setElText('countPerbaikan', perbaikan);
      setElText('distPercent', activeSetoran.length ? Math.round((lancar / activeSetoran.length) * 100) + '%' : '0%');

      renderMonthlyChart(activeSetoran);
      renderSetoranResponsive('recentSetoranContainer', activeSetoran.slice(0, 5), false);
      renderSetoranResponsive('fullSetoranTableContainer', activeSetoran, true);
      renderSantriResponsive(activeSantri);
      renderUstadzResponsive(appState.ustadz);
      renderTargetResponsive(activeTarget);
      populateAllDropdowns(activeSantri);
      renderLaporanRapor();
      renderPlaylistUI();
      populateGasCodeBoxes();
    }

    function renderMonthlyChart(list) {
      const box = document.getElementById('monthlyBarChart');
      if (!box) return;
      const counts = new Array(12).fill(0);
      list.forEach(item =&amp;gt; {
        const parts = String(item.tanggal || '').split('/');
        if (parts.length === 3) {
          const m = parseInt(parts[1], 10) - 1;
          if (m &amp;gt;= 0 &amp;amp;&amp;amp; m &amp;lt; 12) counts[m]++;
        }
      });
      const maxVal = Math.max(...counts, 4);
      box.innerHTML = counts.map(c =&amp;gt; {
        const h = Math.max(Math.round((c / maxVal) * 100), 8);
        return `&amp;lt;div class="flex-1 flex flex-col items-center justify-end h-full"&amp;gt;
          &amp;lt;span class="text-[9px] font-bold text-slate-500 mb-1"&amp;gt;${c || ''}&amp;lt;/span&amp;gt;
          &amp;lt;div class="w-full max-w-[22px] rounded-t-lg bg-gradient-to-t from-emerald-700 to-sky-500" style="height:${h}%"&amp;gt;&amp;lt;/div&amp;gt;
        &amp;lt;/div&amp;gt;`;
      }).join('');
    }

