    // Studio Kamera Rekam Video Setoran
    let mediaRecorder = null;
    let recordedChunks = [];
    let currentRecordedBase64 = null;
    let activeCameraStream = null;

    function openSetoranModal() {
      currentRecordedBase64 = null;
      document.getElementById('setoranModal').classList.remove('hidden');
    }
    function closeSetoranModal() {
      document.getElementById('setoranModal').classList.add('hidden');
      stopCamera();
    }

    async function startCamera() {
      try {
        activeCameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        const v = document.getElementById('cameraPreview');
        if (v) v.srcObject = activeCameraStream;
        document.getElementById('cameraPlaceholder')?.classList.add('hidden');
        document.getElementById('btnStartRec')?.removeAttribute('disabled');
        setElText('recordingStatus', 'Kamera Aktif');
      } catch (err) {
        showToast('Kamera tidak tersedia, silakan pilih file video dari galeri.', 'info');
      }
    }

    function stopCamera() {
      if (activeCameraStream) {
        activeCameraStream.getTracks().forEach(t =&amp;gt; t.stop());
        activeCameraStream = null;
      }
      document.getElementById('cameraPlaceholder')?.classList.remove('hidden');
    }

    function startRecording() {
      if (!activeCameraStream) return;
      recordedChunks = [];
      mediaRecorder = new MediaRecorder(activeCameraStream);
      mediaRecorder.ondataavailable = e =&amp;gt; { if (e.data?.size &amp;gt; 0) recordedChunks.push(e.data); };
      mediaRecorder.onstop = () =&amp;gt; {
        const blob = new Blob(recordedChunks, { type: 'video/webm' });
        const reader = new FileReader();
        reader.onloadend = () =&amp;gt; { currentRecordedBase64 = reader.result; };
        reader.readAsDataURL(blob);
      };
      mediaRecorder.start();
      document.getElementById('btnStartRec')?.setAttribute('disabled', 'true');
      document.getElementById('btnStopRec')?.removeAttribute('disabled');
      setElText('recordingStatus', 'Merekam...');
    }

    function stopRecording() {
      if (mediaRecorder &amp;amp;&amp;amp; mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
        document.getElementById('btnStartRec')?.removeAttribute('disabled');
        document.getElementById('btnStopRec')?.setAttribute('disabled', 'true');
        setElText('recordingStatus', 'Video Tersimpan');
        showToast('Video selesai direkam!');
      }
    }

    function handleVideoFileUpload(e) {
      const file = e.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onloadend = () =&amp;gt; {
        currentRecordedBase64 = reader.result;
        setElText('recordingStatus', 'File Video Siap');
        showToast('File video siap diunggah: ' + file.name);
      };
      reader.readAsDataURL(file);
    }

