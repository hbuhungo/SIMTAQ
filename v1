    // =========================================================================
    // HYBRID ENGINE MUROTAL (MENDUKUNG LINK YOUTUBE &amp;amp; AUDIO MP3 ANTI-BLOKIR)
    // =========================================================================
    let audioState = {
      currentIndex: 0,
      isPlaying: false,
      isMuted: false,
      currentVolume: 0.75, // Skala 0.0 - 1.0 (75%)
      previousVolume: 0.75, // Menyimpan volume sebelum di-mute
      activeMode: 'audio', // 'audio' atau 'youtube'
      ytReady: false,
      showYtVideo: false
    };

    const bgMusicEl = document.getElementById('bg-music');
    let ytPlayerInstance = null;

    // Fungsi Ekstraksi ID Video YouTube dari Berbagai Format Link YouTube
    function extractYouTubeId(url) {
      if (!url || typeof url !== 'string') return null;
      const clean = url.trim();
      const regExp = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|live|shorts)\/|.*[?&amp;amp;]v=)|youtu\.be\/)([^"&amp;amp;?\/\s]{11})/i;
      const match = clean.match(regExp);
      return match &amp;amp;&amp;amp; match[1] ? match[1] : null;
    }

    // Callback Resmi saat YouTube IFrame API Siap
    window.onYouTubeIframeAPIReady = function() {
      ytPlayerInstance = new YT.Player('yt-murotal-player', {
        height: '158',
        width: '280',
        videoId: '1dn6tQ2V3pA',
        playerVars: {
          autoplay: 0,
          controls: 1,
          rel: 0,
          modestbranding: 1,
          playsinline: 1
        },
        events: {
          onReady: () =&amp;gt; {
            audioState.ytReady = true;
            ytPlayerInstance.setVolume(Math.round(audioState.currentVolume * 100));
          },
          onStateChange: (event) =&amp;gt; {
            if (audioState.activeMode !== 'youtube') return;
            if (event.data === YT.PlayerState.PLAYING) {
              audioState.isPlaying = true;
              updateAudioControllerUI();
            } else if (event.data === YT.PlayerState.PAUSED) {
              audioState.isPlaying = false;
              updateAudioControllerUI();
            } else if (event.data === YT.PlayerState.ENDED) {
              // Otomatis putar Murotal berikutnya saat video YouTube selesai
              nextTrack();
            }
          },
          onError: () =&amp;gt; {
            if (audioState.activeMode === 'youtube') {
              showToast('Video YouTube ini membatasi pemutaran embed, beralih ke Murotal berikutnya...', 'info');
              setTimeout(() =&amp;gt; nextTrack(), 1200);
            }
          }
        }
      });
    };

    // Inisialisasi Engine Murotal
    function initAudioEngine() {
      if (!bgMusicEl) return;
      bgMusicEl.volume = audioState.currentVolume;

      bgMusicEl.addEventListener('ended', () =&amp;gt; {
        if (audioState.activeMode === 'audio') nextTrack();
      });

      bgMusicEl.addEventListener('play', () =&amp;gt; {
        if (audioState.activeMode === 'audio') {
          audioState.isPlaying = true;
          updateAudioControllerUI();
        }
      });

      bgMusicEl.addEventListener('pause', () =&amp;gt; {
        if (audioState.activeMode === 'audio') {
          audioState.isPlaying = false;
          updateAudioControllerUI();
        }
      });

      loadTrackByIndex(0, false);
      renderPlaylistUI();
    }

    // 1. Mekanisme Anti-Blokir: Dipanggil saat tombol "Mulai / Masuk Aplikasi" di Welcome Screen diklik
    function enterApplicationWithAudio() {
      const welcomeEl = document.getElementById('welcomeScreen');
      const mainAppEl = document.getElementById('mainAppWrapper');

      if (appState.playlist.length &amp;gt; 0) {
        loadTrackByIndex(audioState.currentIndex, true);
      }

      if (welcomeEl) {
        welcomeEl.classList.add('fade-out');
        setTimeout(() =&amp;gt; {
          welcomeEl.classList.add('hidden');
        }, 650);
      }
      if (mainAppEl) {
        mainAppEl.classList.remove('hidden');
        mainAppEl.classList.add('fade-in');
      }
    }

    // 2. Memuat Murotal (Deteksi Otomatis Link YouTube vs File MP3)
    function loadTrackByIndex(index, autoPlay = true) {
      if (!appState.playlist.length) return;
      if (index &amp;lt; 0) index = appState.playlist.length - 1;
      if (index &amp;gt;= appState.playlist.length) index = 0;

      audioState.currentIndex = index;
      const track = appState.playlist[index];
      const ytId = extractYouTubeId(track.url);

      setElText('currentTrackTitle', track.title);
      setElText('currentTrackArtist', track.artist || 'Murotal Al-Qur’an SIMTAQ');

      const badgeEl = document.getElementById('currentTrackSourceBadge');
      const btnYtPreview = document.getElementById('btnToggleYtPreview');

      if (ytId) {
        // Mode YouTube Murotal
        audioState.activeMode = 'youtube';
        if (bgMusicEl &amp;amp;&amp;amp; !bgMusicEl.paused) bgMusicEl.pause();

        if (badgeEl) {
          badgeEl.innerHTML = '&amp;lt;i class="fa-brands fa-youtube mr-1"&amp;gt;&amp;lt;/i&amp;gt;YouTube';
          badgeEl.className = 'px-1.5 py-0.2 rounded bg-rose-500/30 border border-rose-400/40 text-[9px] font-black text-rose-200 uppercase shrink-0';
        }
        if (btnYtPreview) btnYtPreview.classList.remove('hidden');

        if (audioState.ytReady &amp;amp;&amp;amp; ytPlayerInstance &amp;amp;&amp;amp; typeof ytPlayerInstance.loadVideoById === 'function') {
          if (autoPlay) {
            ytPlayerInstance.loadVideoById(ytId);
            ytPlayerInstance.setVolume(audioState.isMuted ? 0 : Math.round(audioState.currentVolume * 100));
            audioState.isPlaying = true;
          } else {
            ytPlayerInstance.cueVideoById(ytId);
            audioState.isPlaying = false;
          }
        } else if (autoPlay) {
          // Jika API YouTube masih sedang dimuat, tunggu sebentar lalu putar
          setTimeout(() =&amp;gt; {
            if (audioState.ytReady &amp;amp;&amp;amp; ytPlayerInstance) {
              ytPlayerInstance.loadVideoById(ytId);
              ytPlayerInstance.setVolume(audioState.isMuted ? 0 : Math.round(audioState.currentVolume * 100));
            }
          }, 900);
        }
      } else {
        // Mode Audio MP3 Langsung
        audioState.activeMode = 'audio';
        if (audioState.ytReady &amp;amp;&amp;amp; ytPlayerInstance &amp;amp;&amp;amp; typeof ytPlayerInstance.stopVideo === 'function') {
          ytPlayerInstance.stopVideo();
        }
        if (badgeEl) {
          badgeEl.innerHTML = '&amp;lt;i class="fa-solid fa-book-quran mr-1"&amp;gt;&amp;lt;/i&amp;gt;MP3';
          badgeEl.className = 'px-1.5 py-0.2 rounded bg-emerald-500/30 border border-emerald-400/40 text-[9px] font-black text-emerald-200 uppercase shrink-0';
        }
        if (btnYtPreview) btnYtPreview.classList.add('hidden');
        document.getElementById('ytWrapperBox')?.classList.replace('yt-visible-frame', 'yt-hidden-frame');

        if (bgMusicEl) {
          bgMusicEl.src = track.url;
          bgMusicEl.load();
          bgMusicEl.volume = audioState.isMuted ? 0 : audioState.currentVolume;
          if (autoPlay) {
            bgMusicEl.play().then(() =&amp;gt; {
              audioState.isPlaying = true;
              updateAudioControllerUI();
            }).catch(() =&amp;gt; {
              audioState.isPlaying = false;
              updateAudioControllerUI();
            });
          } else {
            audioState.isPlaying = false;
          }
        }
      }

      updateAudioControllerUI();
      renderPlaylistUI();
    }

    function toggleYouTubeMiniVideo() {
      const box = document.getElementById('ytWrapperBox');
      if (!box) return;
      audioState.showYtVideo = !audioState.showYtVideo;
      if (audioState.showYtVideo) {
        box.classList.remove('yt-hidden-frame');
        box.classList.add('yt-visible-frame');
        setElText('textToggleYtPreview', 'Sembunyikan Video YouTube');
      } else {
        box.classList.remove('yt-visible-frame');
        box.classList.add('yt-hidden-frame');
        setElText('textToggleYtPreview', 'Tampilkan Video YouTube');
      }
    }

    function selectTrackFromList(index) {
      loadTrackByIndex(index, true);
    }

    function togglePlayPause() {
      if (!appState.playlist.length) return;

      if (audioState.activeMode === 'youtube') {
        if (!audioState.ytReady || !ytPlayerInstance) {
          showToast('Menyiapkan pemutar YouTube Murotal...', 'info');
          return;
        }
        const st = ytPlayerInstance.getPlayerState();
        if (st === YT.PlayerState.PLAYING) {
          ytPlayerInstance.pauseVideo();
        } else {
          ytPlayerInstance.playVideo();
        }
      } else {
        if (!bgMusicEl) return;
        if (bgMusicEl.paused) {
          bgMusicEl.play().catch(() =&amp;gt; {
            showToast('Gagal memuat stream audio, periksa koneksi atau link Murotal.', 'error');
          });
        } else {
          bgMusicEl.pause();
        }
      }
    }

    function nextTrack() {
      if (!appState.playlist.length) return;
      loadTrackByIndex(audioState.currentIndex + 1, true);
    }

    function prevTrack() {
      if (!appState.playlist.length) return;
      loadTrackByIndex(audioState.currentIndex - 1, true);
    }

    // 3. Kontrol Slider Volume (0 - 100) &amp;amp; Mute dengan Memori Volume Sebelumnya
    function handleVolumeChange(val) {
      const numericVal = Math.max(0, Math.min(100, Number(val)));
      const normalized = numericVal / 100;
      audioState.currentVolume = normalized;

      if (numericVal &amp;gt; 0) {
        audioState.previousVolume = normalized;
        audioState.isMuted = false;
      } else {
        audioState.isMuted = true;
      }

      if (bgMusicEl) {
        bgMusicEl.muted = audioState.isMuted;
        bgMusicEl.volume = normalized;
      }
      if (audioState.ytReady &amp;amp;&amp;amp; ytPlayerInstance) {
        if (audioState.isMuted) ytPlayerInstance.mute();
        else {
          ytPlayerInstance.unMute();
          ytPlayerInstance.setVolume(numericVal);
        }
      }

      syncVolumeControlsUI(numericVal);
    }

    function toggleMuteAudio() {
      if (!audioState.isMuted) {
        audioState.previousVolume = audioState.currentVolume &amp;gt; 0 ? audioState.currentVolume : 0.75;
        audioState.currentVolume = 0;
        audioState.isMuted = true;

        if (bgMusicEl) {
          bgMusicEl.muted = true;
          bgMusicEl.volume = 0;
        }
        if (audioState.ytReady &amp;amp;&amp;amp; ytPlayerInstance) {
          ytPlayerInstance.mute();
          ytPlayerInstance.setVolume(0);
        }
        syncVolumeControlsUI(0);
      } else {
        const restored = audioState.previousVolume &amp;gt; 0 ? audioState.previousVolume : 0.75;
        const percentVal = Math.round(restored * 100);
        audioState.currentVolume = restored;
        audioState.isMuted = false;

        if (bgMusicEl) {
          bgMusicEl.muted = false;
          bgMusicEl.volume = restored;
        }
        if (audioState.ytReady &amp;amp;&amp;amp; ytPlayerInstance) {
          ytPlayerInstance.unMute();
          ytPlayerInstance.setVolume(percentVal);
        }
        syncVolumeControlsUI(percentVal);
      }
    }

    function syncVolumeControlsUI(percentVal) {
      const sDesktop = document.getElementById('volumeSlider');
      const sMobile = document.getElementById('volumeSliderMobile');
      if (sDesktop) sDesktop.value = percentVal;
      if (sMobile) sMobile.value = percentVal;

      setElText('volumeValueText', percentVal + '%');
      setElText('volumeValueTextMobile', percentVal + '%');

      const iconMute = document.getElementById('iconMuteStatus');
      const textMute = document.getElementById('textMuteStatus');
      if (iconMute) {
        if (audioState.isMuted || percentVal === 0) {
          iconMute.className = 'fa-solid fa-volume-xmark text-rose-400';
          if (textMute) textMute.textContent = 'Mute';
        } else if (percentVal &amp;lt; 50) {
          iconMute.className = 'fa-solid fa-volume-low text-emerald-300';
          if (textMute) textMute.textContent = 'Suara';
        } else {
          iconMute.className = 'fa-solid fa-volume-high text-emerald-300';
          if (textMute) textMute.textContent = 'Suara';
        }
      }
    }

    function updateAudioControllerUI() {
      const iconPP = document.getElementById('iconPlayPause');
      const eq = document.getElementById('eqIndicator');
      if (iconPP) {
        iconPP.className = audioState.isPlaying ? 'fa-solid fa-pause' : 'fa-solid fa-play';
      }
      if (eq) {
        eq.classList.toggle('eq-paused', !audioState.isPlaying);
      }
      renderPlaylistUI();
    }

    function togglePlaylistDrawer() {
      const drawer = document.getElementById('playlistDrawer');
      if (drawer) drawer.classList.toggle('hidden');
    }

    function renderPlaylistUI() {
      setElText('playlistBadgeCount', appState.playlist.length);
      const box = document.getElementById('playlistItemsContainer');
      if (box) {
        if (!appState.playlist.length) {
          box.innerHTML = `&amp;lt;p class="text-[11px] text-slate-300 col-span-3 py-2 text-center"&amp;gt;Belum ada Murotal di dalam daftar putar.&amp;lt;/p&amp;gt;`;
        } else {
          box.innerHTML = appState.playlist.map((t, idx) =&amp;gt; {
            const active = idx === audioState.currentIndex;
            const isYt = Boolean(extractYouTubeId(t.url));
            return `
              &amp;lt;div onclick="selectTrackFromList(${idx})" class="cursor-pointer p-2.5 rounded-xl border transition flex items-center justify-between gap-2 ${active ? 'bg-emerald-500/25 border-emerald-400 text-white' : 'bg-white/5 border-white/10 text-slate-200 hover:bg-white/10'}"&amp;gt;
                &amp;lt;div class="flex items-center space-x-2 min-w-0"&amp;gt;
                  &amp;lt;span class="w-6 h-6 rounded-lg ${active ? 'bg-emerald-500 text-white' : 'bg-white/10 text-slate-300'} flex items-center justify-center text-[10px] font-black shrink-0"&amp;gt;
                    ${active &amp;amp;&amp;amp; audioState.isPlaying ? '&amp;lt;i class="fa-solid fa-volume-high"&amp;gt;&amp;lt;/i&amp;gt;' : (idx + 1)}
                  &amp;lt;/span&amp;gt;
                  &amp;lt;div class="min-w-0"&amp;gt;
                    &amp;lt;p class="text-[11px] font-extrabold truncate"&amp;gt;${t.title}&amp;lt;/p&amp;gt;
                    &amp;lt;p class="text-[9px] text-slate-300 truncate flex items-center gap-1"&amp;gt;
                      ${isYt ? '&amp;lt;i class="fa-brands fa-youtube text-rose-400"&amp;gt;&amp;lt;/i&amp;gt;' : '&amp;lt;i class="fa-solid fa-book-quran text-emerald-300"&amp;gt;&amp;lt;/i&amp;gt;'}
                      &amp;lt;span&amp;gt;${t.artist || 'Murotal SIMTAQ'}&amp;lt;/span&amp;gt;
                    &amp;lt;/p&amp;gt;
                  &amp;lt;/div&amp;gt;
                &amp;lt;/div&amp;gt;
                &amp;lt;span class="text-[10px] font-bold ${active ? 'text-emerald-300' : 'text-slate-400'} shrink-0"&amp;gt;
                  ${active ? 'Aktif' : 'Putar'}
                &amp;lt;/span&amp;gt;
              &amp;lt;/div&amp;gt;
            `;
          }).join('');
        }
      }

      renderAdminMusicTable();
      renderModalMusicList();
    }

    // =========================================================================
    // HAK AKSES ADMIN: TAMBAH, EDIT &amp;amp; HAPUS LINK YOUTUBE / MP3 MUROTAL
    // =========================================================================
    function previewDetectedMurotalSource(urlVal) {
      const hint = document.getElementById('detectedSourceHint');
      if (!hint) return;
      const ytId = extractYouTubeId(urlVal);
      if (ytId) {
        hint.innerHTML = `&amp;lt;span class="text-emerald-700 font-extrabold"&amp;gt;&amp;lt;i class="fa-brands fa-youtube text-rose-600 mr-1"&amp;gt;&amp;lt;/i&amp;gt;Link YouTube Valid Terdeteksi (ID Video: &amp;lt;code&amp;gt;${ytId}&amp;lt;/code&amp;gt;) — Siap diputar!&amp;lt;/span&amp;gt;`;
      } else if (urlVal &amp;amp;&amp;amp; urlVal.trim().length &amp;gt; 5) {
        hint.innerHTML = `&amp;lt;span class="text-sky-700 font-bold"&amp;gt;&amp;lt;i class="fa-solid fa-file-audio mr-1"&amp;gt;&amp;lt;/i&amp;gt;Terdeteksi sebagai URL Audio MP3 / Stream Langsung.&amp;lt;/span&amp;gt;`;
      } else {
        hint.innerHTML = `Tempelkan link YouTube (&amp;lt;code&amp;gt;youtube.com/watch?v=...&amp;lt;/code&amp;gt; atau &amp;lt;code&amp;gt;youtu.be/...&amp;lt;/code&amp;gt;) maupun link MP3 langsung.`;
      }
    }

    function openMusicAdminModal(editId = null) {
      if (appState.currentUser?.role !== 'admin') {
        showToast('Hanya Administrator yang dapat mengelola daftar Murotal!', 'error');
        return;
      }
      if (editId) {
        populateMusicFormForEdit(editId);
      } else {
        resetMusicForm();
      }
      renderModalMusicList();
      document.getElementById('musicAdminModal').classList.remove('hidden');
