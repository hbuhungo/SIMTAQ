    function playVideo(setoranId) {
      const item = appState.setoran.find(x => x.id === setoranId);
      const modal = document.getElementById('videoPlayerModal');
      const v = document.getElementById('modalVideoElement');
      const linkEl = document.getElementById('videoDriveExternalLink');
      if (!modal || !v) return;

      // Jeda Murotal otomatis saat memutar video setoran santri
      if (bgMusicEl && !bgMusicEl.paused) bgMusicEl.pause();
      if (audioState.ytReady && ytPlayerInstance && typeof ytPlayerInstance.pauseVideo === 'function') {
        ytPlayerInstance.pauseVideo();
      }

      const url = item?.videoBlobUrl || '';
      if (url.includes('drive.google.com')) {
        if (linkEl) {
          linkEl.href = url;
          linkEl.classList.remove('hidden');
        }
      } else if (linkEl) {
        linkEl.classList.add('hidden');
      }

      v.src = (url && !url.includes('drive.google.com/file')) ? url : 'https://www.w3schools.com/html/mov_bbb.mp4';
      setElText('videoModalCaption', item ? `${item.santriNama} - Surat ${item.surat} (${item.ayat})` : 'Rekaman Video Setoran');
      modal.classList.remove('hidden');
      v.play().catch(() => {});
    }

