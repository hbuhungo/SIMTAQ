    function handleLocalAudioUpload(e) {
      const file = e.target.files?.[0];
      if (!file) return;
      if (file.size > 4.5 * 1024 * 1024) {
        showToast('Ukuran file MP3 maksimal 4MB agar ringan disimpan.', 'error');
        return;
      }
      const reader = new FileReader();
      reader.onloadend = () => {
        document.getElementById('formMusicUrl').value = reader.result;
        if (!document.getElementById('formMusicTitle').value) {
          document.getElementById('formMusicTitle').value = file.name.replace(/\.[^/.]+$/, '');
        }
        previewDetectedMurotalSource(reader.result);
        showToast('File MP3 Murotal berhasil dimuat ke form!');
      };
      reader.readAsDataURL(file);
    }

    function handleSaveMusicTrack(e) {
      e.preventDefault();
      if (appState.currentUser?.role !== 'admin') return;

      const editId = document.getElementById('editMusicId').value;
      const trackObj = {
        id: editId || ('MRT-' + Date.now()),
        title: document.getElementById('formMusicTitle').value.trim(),
        artist: document.getElementById('formMusicArtist').value.trim(),
        url: document.getElementById('formMusicUrl').value.trim()
      };

      const existingIdx = appState.playlist.findIndex(x => x.id === trackObj.id);
      if (existingIdx >= 0) {
        appState.playlist[existingIdx] = trackObj;
        if (audioState.currentIndex === existingIdx) {
          loadTrackByIndex(existingIdx, audioState.isPlaying);
        }
        showToast('Data Murotal berhasil diperbarui!');
      } else {
        appState.playlist.push(trackObj);
        showToast('Murotal baru berhasil ditambahkan ke playlist!');
      }

      persistLocalState();
      if (isGasEnvironment()) {
        google.script.run.upsertMusicGAS(trackObj);
      }
      resetMusicForm();
      renderPlaylistUI();
    }

    function deleteMusicTrack(id) {
      if (appState.currentUser?.role !== 'admin') return;
      if (appState.playlist.length <= 1) {
        showToast('Minimal harus ada 1 Murotal di dalam playlist!', 'error');
        return;
      }
      const deletedIdx = appState.playlist.findIndex(x => x.id === id);
      appState.playlist = appState.playlist.filter(x => x.id !== id);

      if (deletedIdx === audioState.currentIndex) {
        loadTrackByIndex(0, audioState.isPlaying);
      } else if (deletedIdx < audioState.currentIndex) {
        audioState.currentIndex = Math.max(0, audioState.currentIndex - 1);
      }

      persistLocalState();
      if (isGasEnvironment()) {
        google.script.run.deleteRecordByIdGAS('Musik_Latar', id);
      }
      renderPlaylistUI();
      showToast('Murotal berhasil dihapus dari playlist.');
    }

