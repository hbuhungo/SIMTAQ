                &amp;lt;i class="fa-brands fa-youtube text-rose-400 mr-1"&amp;gt;&amp;lt;/i&amp;gt;&amp;lt;span id="textToggleYtPreview"&amp;gt;Tampilkan Video YouTube&amp;lt;/span&amp;gt;
              &amp;lt;/button&amp;gt;
              &amp;lt;button onclick="openMusicAdminModal()" id="btnDrawerAddMusic" class="text-amber-300 hover:underline font-extrabold text-[11px]"&amp;gt;
