      "  const ss = getSpreadsheet_();",
      "  const schema = {",
      "    'Data_Santri': ['ID', 'NIS', 'Nama', 'JK', 'Kelas', 'Asrama', 'Juz', 'Status'],",
      "    'Data_Ustadz': ['ID', 'NIP', 'Nama', 'Lembaga', 'Halaqah', 'Kontak', 'Status'],",
      "    'Setoran_Hafalan': ['ID', 'Tanggal', 'SantriID', 'NIS', 'SantriNama', 'Surat', 'Ayat', 'Juz', 'Nilai', 'Ustadz', 'Catatan', 'HasVideo', 'VideoUrl'],",
      "    'Target_Hafalan': ['ID', 'SantriID', 'NIS', 'SantriNama', 'Kelas', 'Target', 'TanggalTarget', 'Status'],",
      "    'Musik_Latar': ['ID', 'Title', 'Artist', 'Url'],",
      "    'Pengaturan_Pejabat': ['Key', 'Value']",
      "  };",
      "  Object.keys(schema).forEach(name => {",
      "    let s = ss.getSheetByName(name);",
      "    if (!s) {",
      "      s = ss.insertSheet(name);",
      "      s.appendRow(schema[name]);",
      "      s.getRange(1, 1, 1, schema[name].length).setBackground('#0f6832').setFontColor('#ffffff').setFontWeight('bold');",
      "    }",
      "  });",
      "  const musikSheet = ss.getSheetByName('Musik_Latar');",
      "  if (musikSheet.getLastRow() <= 1) {",
      "    musikSheet.appendRow(['MRT-01', 'Murotal QS. Ar-Rahman (Ayat 1-78)', 'Syaikh Mishary Rashid Al-Afasy', 'https://server8.mp3quran.net/afs/055.mp3']);",
      "    musikSheet.appendRow(['MRT-02', 'Murotal QS. Al-Mulk (Penjaga dari Siksa Kubur)', 'Syaikh Mishary Rashid Al-Afasy', 'https://server8.mp3quran.net/afs/067.mp3']);",
      "    musikSheet.appendRow(['MRT-03', 'Murotal Merdu Juz 30 (YouTube Murotal)', 'Murotal Al-Qur’an Pilihan (YouTube)', 'https://www.youtube.com/watch?v=1dn6tQ2V3pA']);",
      "  }",
      "}",
      "",
      "function getAllSimtaqData() {",
      "  initSheetsIfNeeded();",
      "  const ss = getSpreadsheet_();",
      "  const read = (name) => {",
      "    const s = ss.getSheetByName(name);",
      "    if (!s || s.getLastRow() <= 1) return [];",
      "    return s.getRange(2, 1, s.getLastRow() - 1, s.getLastColumn()).getDisplayValues();",
      "  };",
      "  const santri = read('Data_Santri').map(r => ({ id: r[0], nis: r[1], nama: r[2], jk: r[3], kelas: r[4], asrama: r[5], juz: Number(r[6] || 1), status: r[7] || 'Aktif' }));",
      "  const ustadz = read('Data_Ustadz').map(r => ({ id: r[0], nip: r[1], nama: r[2], lembaga: r[3], halaqah: r[4], kontak: r[5], status: r[6] || 'Aktif' }));",
      "  const setoran = read('Setoran_Hafalan').map(r => ({ id: r[0], tanggal: r[1], santriId: r[2], nis: r[3], santriNama: r[4], surat: r[5], ayat: r[6], juz: Number(r[7] || 1), nilai: Number(r[8] || 0), ustadz: r[9], catatan: r[10], hasVideo: r[11] === 'TRUE' || Boolean(r[12]), videoBlobUrl: r[12] || '' }));",
      "  const target = read('Target_Hafalan').map(r => ({ id: r[0], santriId: r[1], nis: r[2], santriNama: r[3], kelas: r[4], target: r[5], tanggalTarget: r[6], status: r[7] || 'Proses' }));",
      "  const playlist = read('Musik_Latar').map(r => ({ id: r[0], title: r[1], artist: r[2], url: r[3] }));",
      "  const pejabat = {};",
      "  read('Pengaturan_Pejabat').forEach(r => { if (r[0]) pejabat[r[0]] = r[1]; });",
      "  return { santri, ustadz, setoran, target, playlist, pejabat };",
      "}",
      "",
      "function upsertMusicGAS(m) {",
      "  initSheetsIfNeeded();",
      "  const sheet = getSpreadsheet_().getSheetByName('Musik_Latar');",
      "  const data = sheet.getDataRange().getValues();",
      "  for (let i = 1; i < data.length; i++) {",
      "    if (String(data[i][0]) === String(m.id)) {",
      "      sheet.getRange(i + 1, 1, 1, 4).setValues([[m.id, m.title, m.artist, m.url]]);",
      "      return { status: 'updated' };",
      "    }",
      "  }",
      "  sheet.appendRow([m.id, m.title, m.artist, m.url]);",
      "  return { status: 'inserted' };",
      "}",
      "",
      "function saveSetoranWithVideo(payload) {",
      "  initSheetsIfNeeded();",
      "  const sheet = getSpreadsheet_().getSheetByName('Setoran_Hafalan');",
      "  let videoUrl = '';",
      "  if (payload.videoBase64 && payload.videoBase64.indexOf('base64,') !== -1) {",
      "    const folder = getDriveFolder_();",
      "    const bytes = Utilities.base64Decode(payload.videoBase64.split(',')[1]);",
      "    const cleanName = (payload.santriNama || 'Santri').replace(/[^a-zA-Z0-9]/g, '_');",
      "    const blob = Utilities.newBlob(bytes, payload.videoMimeType || 'video/webm', 'SIMTAQ_' + payload.nis + '_' + cleanName + '_' + Date.now() + '.webm');",
      "    const file = folder.createFile(blob);",
      "    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);",
      "    videoUrl = file.getUrl();",
      "  }",
      "  sheet.appendRow([payload.id, payload.tanggal, payload.santriId, payload.nis, payload.santriNama, payload.surat, payload.ayat, payload.juz, payload.nilai, payload.ustadz, payload.catatan, Boolean(videoUrl || payload.hasVideo), videoUrl]);",
      "  return { status: 'success', videoUrl: videoUrl };",
      "}",
      "",
      "function upsertSantriGAS(s) {",
      "  initSheetsIfNeeded();",
      "  const sheet = getSpreadsheet_().getSheetByName('Data_Santri');",
      "  const data = sheet.getDataRange().getValues();",
      "  for (let i = 1; i < data.length; i++) {",
      "    if (String(data[i][0]) === String(s.id)) {",
      "      sheet.getRange(i + 1, 1, 1, 8).setValues([[s.id, s.nis, s.nama, s.jk, s.kelas, s.asrama, s.juz, s.status]]);",
      "      return { status: 'updated' };",
      "    }",
      "  }",
      "  sheet.appendRow([s.id, s.nis, s.nama, s.jk, s.kelas, s.asrama, s.juz, s.status]);",
      "  return { status: 'inserted' };",
      "}",
      "",
      "function upsertUstadzGAS(u) {",
      "  initSheetsIfNeeded();",
      "  const sheet = getSpreadsheet_().getSheetByName('Data_Ustadz');",
      "  const data = sheet.getDataRange().getValues();",
      "  for (let i = 1; i < data.length; i++) {",
      "    if (String(data[i][0]) === String(u.id)) {",
      "      sheet.getRange(i + 1, 1, 1, 7).setValues([[u.id, u.nip, u.nama, u.lembaga, u.halaqah, u.kontak, u.status]]);",
      "      return { status: 'updated' };",
      "    }",
      "  }",
      "  sheet.appendRow([u.id, u.nip, u.nama, u.lembaga, u.halaqah, u.kontak, u.status]);",
      "  return { status: 'inserted' };",
      "}",
      "",
      "function upsertTargetGAS(t) {",
      "  initSheetsIfNeeded();",
      "  const sheet = getSpreadsheet_().getSheetByName('Target_Hafalan');",
      "  const data = sheet.getDataRange().getValues();",
      "  for (let i = 1; i < data.length; i++) {",
      "    if (String(data[i][0]) === String(t.id)) {",
      "      sheet.getRange(i + 1, 1, 1, 8).setValues([[t.id, t.santriId, t.nis, t.santriNama, t.kelas, t.target, t.tanggalTarget, t.status]]);",
      "      return { status: 'updated' };",
      "    }",
      "  }",
      "  sheet.appendRow([t.id, t.santriId, t.nis, t.santriNama, t.kelas, t.target, t.tanggalTarget, t.status]);",
      "  return { status: 'inserted' };",
      "}",
      "",
      "function deleteRecordByIdGAS(sheetName, recordId) {",
      "  initSheetsIfNeeded();",
      "  const sheet = getSpreadsheet_().getSheetByName(sheetName);",
      "  if (!sheet) return { status: 'not_found' };",
      "  const data = sheet.getDataRange().getValues();",
      "  for (let i = data.length - 1; i >= 1; i--) {",
      "    if (String(data[i][0]) === String(recordId)) {",
      "      sheet.deleteRow(i + 1);",
      "      return { status: 'deleted' };",
      "    }",
      "  }",
      "  return { status: 'not_found' };",
      "}",
      "",
      "function savePejabatGAS(pejabatObj) {",
      "  initSheetsIfNeeded();",
      "  const sheet = getSpreadsheet_().getSheetByName('Pengaturan_Pejabat');",
      "  sheet.clearContents();",
      "  sheet.appendRow(['Key', 'Value']);",
      "  Object.keys(pejabatObj).forEach(k => sheet.appendRow([k, pejabatObj[k]]));",
      "  return { status: 'success' };",
      "}"
    ].join("\n");

    function populateGasCodeBoxes() {
      setElText('rawCodeGsBox', GAS_BACKEND_CODE);
      const htmlBox = document.getElementById('rawIndexHtmlBox');
      if (htmlBox && !htmlBox.textContent) {
        htmlBox.textContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      }
    }

    function switchGasSubTab(mode) {
      const pGs = document.getElementById('panelCodeGs');
      const pHtml = document.getElementById('panelIndexHtml');
      const bGs = document.getElementById('btnSubTabGs');
      const bHtml = document.getElementById('btnSubTabHtml');

      if (mode === 'gs') {
        pGs?.classList.remove('hidden');
        pHtml?.classList.add('hidden');
        if (bGs) bGs.className = 'px-4 py-2 rounded-xl text-xs font-extrabold bg-emerald-700 text-white';
        if (bHtml) bHtml.className = 'px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-100 text-slate-700';
      } else {
        pHtml?.classList.remove('hidden');
        pGs?.classList.add('hidden');
        if (bHtml) bHtml.className = 'px-4 py-2 rounded-xl text-xs font-extrabold bg-emerald-700 text-white';
        if (bGs) bGs.className = 'px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-100 text-slate-700';
        setElText('rawIndexHtmlBox', "<!DOCTYPE html>\n" + document.documentElement.outerHTML);
      }
    }

    function copyStringToClipboard(text, successMsg) {
      try {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.top = '-9999px';
        textArea.style.left = '-9999px';
        textArea.setAttribute('readonly', '');
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        textArea.setSelectionRange(0, textArea.value.length);
        const copied = document.execCommand('copy');
        document.body.removeChild(textArea);
        if (copied) {
          showToast(successMsg || 'Kode berhasil disalin ke clipboard!');
        } else {
          showToast('Silakan gunakan tombol Unduh jika penyalinan dibatasi browser.', 'info');
        }
      } catch (err) {
        showToast('Gagal menyalin otomatis, silakan klik tombol Unduh di sebelahnya.', 'error');
      }
    }

    function copyTextById(id) {
      const el = document.getElementById(id);
      if (el) {
        copyStringToClipboard(el.textContent, 'Kode Code.gs berhasil disalin ke clipboard!');
      }
    }

    function copyFullIndexHtml() {
      const fullHtml = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      copyStringToClipboard(fullHtml, 'Kode lengkap Index.html berhasil disalin ke clipboard!');
    }

    function downloadFileFromBox(id, filename) {
      const el = document.getElementById(id);
      if (!el) return;
      const blob = new Blob([el.textContent], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      a.click();
    }

    function downloadFullIndexHtml() {
      const fullHtml = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'Index.html';
      a.click();
    }

    window.addEventListener('DOMContentLoaded', () => {
      loadInitialData();
      initAudioEngine();
      renderNavigationMenus();
      refreshAllViews();
    });
  </script>

