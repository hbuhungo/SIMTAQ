&lt;body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between selection:bg-emerald-600 selection:text-white"&gt;

  &lt;!-- =====================================================================
       BLOK 2: HTML STRUCTURE (WELCOME SCREEN, ENGINE MUROTAL &amp; MAIN APP)
       ===================================================================== --&gt;

  &lt;!-- Elemen Audio Tunggal (Untuk Link MP3) &amp; Kontainer YouTube IFrame API (Untuk Link YouTube) --&gt;
  &lt;audio id="bg-music" preload="auto" src="https://server8.mp3quran.net/afs/055.mp3"&gt;&lt;/audio&gt;
  &lt;div id="ytWrapperBox" class="yt-hidden-frame no-print"&gt;
    &lt;iframe id="yt-murotal-player" frameborder="0" allowfullscreen="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" title="YouTube video player" width="280" height="158" src="https://www.youtube.com/embed/1dn6tQ2V3pA?autoplay=0&amp;amp;controls=1&amp;amp;rel=0&amp;amp;modestbranding=1&amp;amp;playsinline=1&amp;amp;enablejsapi=1&amp;amp;widgetid=1&amp;amp;forigin=blob%3Ahttps%3A%2F%2F639wwxubz7lwhucs5571173af8z146v8l1lbajhw81gbiwom13-h1013078785.scf.usercontent.goog%2Fffdf2744-9ca4-4452-b8d1-5234d7ac218b&amp;amp;aoriginsup=1&amp;amp;aorigins=https%3A%2F%2Fgemini.google.com&amp;amp;vf=1"&gt;&lt;/iframe&gt;
  &lt;/div&gt;

  &lt;!-- 1. WELCOME SCREEN OVERLAY (Pemicu Anti-Blokir Browser Modern) --&gt;
  &lt;div id="welcomeScreen" class="welcome-screen fade-out hidden"&gt;
    &lt;div class="welcome-card space-y-5"&gt;
      &lt;!-- Logo Kolaborasi Madrasah &amp; Yayasan --&gt;
      &lt;div class="flex items-center justify-center space-x-3"&gt;
        &lt;img src="https://iili.io/nPt9Ol4.jpg" alt="Logo MAN 2 Kab. Gorontalo" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-emerald-400 shadow-lg bg-white"&gt;
        &lt;div class="h-10 w-0.5 bg-white/25 rounded-full"&gt;&lt;/div&gt;
        &lt;img src="https://iili.io/nPsE7oX.jpg" alt="Logo Yayasan Abulyatama" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-sky-400 shadow-lg bg-white"&gt;
      &lt;/div&gt;

      &lt;!-- Judul &amp; Deskripsi Singkat --&gt;
      &lt;div class="space-y-1.5"&gt;
        &lt;span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full bg-white/10 text-emerald-200 text-[11px] font-bold border border-white/15"&gt;
          &lt;i class="fa-solid fa-mosque"&gt;&lt;/i&gt;
          &lt;span&gt;Program Tahfidz Al-Qur’an Digital&lt;/span&gt;
        &lt;/span&gt;
        &lt;h1 class="text-3xl sm:text-4xl font-black simtaq-welcome-title tracking-wider"&gt;SIMTAQ&lt;/h1&gt;
        &lt;p class="text-xs sm:text-sm font-bold text-emerald-100"&gt;Sistem Informasi Monitoring Tahfiz Al-Qur’an&lt;/p&gt;
        &lt;p class="text-[11px] sm:text-xs text-slate-200/90 leading-relaxed pt-1"&gt;
          Kolaborasi resmi &lt;strong&gt;MAN 2 Kabupaten Gorontalo&lt;/strong&gt; bersama &lt;strong&gt;Yayasan Abulyatama Indonesia Gorontalo&lt;/strong&gt;. Dilengkapi fitur pemantauan capaian juz, rekam video setoran, dan lantunan Murotal Al-Qur’an.
        &lt;/p&gt;
      &lt;/div&gt;

      &lt;!-- Informasi Murotal Siap Putar --&gt;
      &lt;div class="p-3 rounded-2xl bg-black/25 border border-white/10 flex items-center justify-center space-x-2.5 text-left"&gt;
        &lt;div class="w-8 h-8 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300 shrink-0"&gt;
          &lt;i class="fa-solid fa-book-quran text-xs"&gt;&lt;/i&gt;
        &lt;/div&gt;
        &lt;div class="min-w-0"&gt;
          &lt;p class="text-[11px] font-extrabold text-white truncate"&gt;Lantunan Murotal Al-Qur’an (YouTube &amp;amp; Audio)&lt;/p&gt;
          &lt;p class="text-[10px] text-slate-300 truncate"&gt;Klik tombol di bawah untuk memulai aplikasi &amp;amp; memutar Murotal&lt;/p&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;!-- Tombol Utama Pemicu Interaksi &amp; Murotal (.play()) --&gt;
      &lt;button id="btnEnterApp" onclick="enterApplicationWithAudio()" class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 via-teal-500 to-sky-500 hover:from-emerald-400 hover:to-sky-400 text-white font-black text-xs sm:text-sm shadow-xl shadow-emerald-950/50 transition transform active:scale-98 flex items-center justify-center space-x-2"&gt;
        &lt;i class="fa-solid fa-circle-play text-base"&gt;&lt;/i&gt;
        &lt;span&gt;Mulai / Masuk Aplikasi&lt;/span&gt;
      &lt;/button&gt;

      &lt;p class="text-[10px] text-slate-300/80 font-semibold pt-1"&gt;
        Pengembang Aplikasi : Herman Susanto Buhungo, S.Pd.
      &lt;/p&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;!-- 2. MAIN APPLICATION (Disembunyikan di Awal dengan class="main-app hidden") --&gt;
  &lt;div id="mainAppWrapper" class="main-app min-h-screen flex flex-col justify-between fade-in"&gt;

    &lt;!-- ================= PANEL KONTROL MUROTAL TERINTEGRASI ================= --&gt;
    &lt;div class="audio-controller-wrapper text-white no-print sticky top-0 z-50 shadow-md"&gt;
      &lt;div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2"&gt;
        &lt;div class="flex flex-wrap items-center justify-between gap-2"&gt;

          &lt;!-- Info Murotal Aktif &amp; Indikator Equalizer --&gt;
          &lt;div class="flex items-center space-x-2.5 min-w-0 flex-1"&gt;
            &lt;div id="eqIndicator" class="flex items-end space-x-0.5 h-3.5 px-1.5 py-0.5 rounded bg-white/10 shrink-0"&gt;
              &lt;span class="eq-bar"&gt;&lt;/span&gt;
              &lt;span class="eq-bar"&gt;&lt;/span&gt;
              &lt;span class="eq-bar"&gt;&lt;/span&gt;
            &lt;/div&gt;
            &lt;div class="min-w-0 flex-1"&gt;
              &lt;div class="flex items-center space-x-1.5"&gt;
                &lt;span id="currentTrackSourceBadge" class="px-1.5 py-0.2 rounded bg-emerald-500/30 border border-emerald-400/40 text-[9px] font-black text-emerald-200 uppercase shrink-0"&gt;&lt;i class="fa-solid fa-book-quran mr-1"&gt;&lt;/i&gt;MP3&lt;/span&gt;
                &lt;p class="text-[11px] sm:text-xs font-extrabold text-emerald-200 truncate" id="currentTrackTitle"&gt;Murotal QS. Ar-Rahman (Ayat 1-78)&lt;/p&gt;
              &lt;/div&gt;
              &lt;p class="text-[9px] sm:text-[10px] text-slate-300 truncate" id="currentTrackArtist"&gt;Syaikh Mishary Rashid Al-Afasy&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;!-- Tombol Navigasi Murotal: Prev, Play/Pause, Next, Mute, Slider Volume, &amp; Toggle Playlist --&gt;
          &lt;div class="flex items-center space-x-1.5 sm:space-x-2 shrink-0"&gt;
            &lt;!-- Tombol Previous --&gt;
            &lt;button onclick="prevTrack()" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-xs transition" title="Murotal Sebelumnya"&gt;
              &lt;i class="fa-solid fa-backward-step"&gt;&lt;/i&gt;
            &lt;/button&gt;

            &lt;!-- Tombol Play / Pause --&gt;
            &lt;button onclick="togglePlayPause()" id="btnPlayPause" class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-white flex items-center justify-center text-xs shadow-xs transition" title="Putar / Jeda Murotal"&gt;
              &lt;i class="fa-solid fa-pause" id="iconPlayPause"&gt;&lt;/i&gt;
            &lt;/button&gt;

            &lt;!-- Tombol Next --&gt;
            &lt;button onclick="nextTrack()" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-xs transition" title="Murotal Berikutnya"&gt;
              &lt;i class="fa-solid fa-forward-step"&gt;&lt;/i&gt;
            &lt;/button&gt;

            &lt;!-- Tombol Mute / Unmute Dinamis --&gt;
            &lt;button onclick="toggleMuteAudio()" id="btnMuteToggle" class="px-2.5 h-7 sm:h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center space-x-1 text-[11px] font-bold transition" title="Bisukan / Bunyikan Suara"&gt;
              &lt;i class="fa-solid fa-volume-high text-emerald-300" id="iconMuteStatus"&gt;&lt;/i&gt;
              &lt;span id="textMuteStatus" class="hidden sm:inline"&gt;Suara&lt;/span&gt;
            &lt;/button&gt;

            &lt;!-- Slider Volume (0 - 100) --&gt;
            &lt;div class="hidden sm:flex items-center space-x-1.5 bg-white/10 px-2.5 py-1 rounded-lg"&gt;
              &lt;input type="range" id="volumeSlider" min="0" max="100" value="75" class="volume-slider w-16 md:w-20" oninput="handleVolumeChange(this.value)"&gt;
              &lt;span id="volumeValueText" class="text-[10px] font-extrabold text-emerald-200 w-7 text-right"&gt;75%&lt;/span&gt;
            &lt;/div&gt;

            &lt;!-- Tombol Buka Daftar Putar Murotal (Playlist) --&gt;
            &lt;button onclick="togglePlaylistDrawer()" class="px-2.5 h-7 sm:h-8 rounded-lg bg-sky-500/30 hover:bg-sky-500/50 border border-sky-400/30 flex items-center space-x-1 text-[11px] font-extrabold transition"&gt;
              &lt;i class="fa-solid fa-book-quran text-sky-200"&gt;&lt;/i&gt;
              &lt;span class="hidden xs:inline"&gt;Murotal&lt;/span&gt;
              &lt;span id="playlistBadgeCount" class="px-1.5 py-0.2 rounded-full bg-sky-500 text-white text-[9px]"&gt;3&lt;/span&gt;
            &lt;/button&gt;

            &lt;!-- Tombol Khusus Admin: Kelola Murotal --&gt;
            &lt;button onclick="openMusicAdminModal()" id="btnAdminManageMusic" class="px-2.5 h-7 sm:h-8 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 flex items-center space-x-1 text-[11px] font-black transition" title="Tambah / Edit / Hapus Link YouTube Murotal (Admin)"&gt;
              &lt;i class="fa-brands fa-youtube text-rose-700"&gt;&lt;/i&gt;
              &lt;span class="hidden md:inline"&gt;Kelola Murotal&lt;/span&gt;
            &lt;/button&gt;
          &lt;/div&gt;

        &lt;/div&gt;

        &lt;!-- Drawer Playlist Murotal &amp; Kontrol Volume Smartphone --&gt;
        &lt;div id="playlistDrawer" class="hidden mt-2.5 pt-2.5 border-t border-white/15 space-y-2.5"&gt;
          &lt;!-- Slider Volume Khusus Layar Smartphone --&gt;
          &lt;div class="flex sm:hidden items-center justify-between gap-3 bg-white/10 px-3 py-2 rounded-xl"&gt;
            &lt;span class="text-[11px] font-bold text-slate-200 flex items-center gap-1.5"&gt;
              &lt;i class="fa-solid fa-volume-low text-emerald-300"&gt;&lt;/i&gt; Volume Murotal
            &lt;/span&gt;
            &lt;div class="flex items-center space-x-2 flex-1 max-w-[180px]"&gt;
              &lt;input type="range" id="volumeSliderMobile" min="0" max="100" value="75" class="volume-slider w-full" oninput="handleVolumeChange(this.value)"&gt;
              &lt;span id="volumeValueTextMobile" class="text-[10px] font-extrabold text-emerald-200 w-8 text-right"&gt;75%&lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-300 px-1"&gt;
            &lt;span class="font-bold uppercase tracking-wider text-[10px] text-emerald-300"&gt;
              &lt;i class="fa-solid fa-book-open-reader mr-1"&gt;&lt;/i&gt;Daftar Putar Murotal Al-Qur’an (Mendukung Link YouTube &amp;amp; MP3)
            &lt;/span&gt;
            &lt;div class="flex items-center space-x-3"&gt;
              &lt;button onclick="toggleYouTubeMiniVideo()" id="btnToggleYtPreview" class="hidden text-sky-300 hover:underline font-extrabold text-[11px]"&gt;
                &lt;i class="fa-brands fa-youtube text-rose-400 mr-1"&gt;&lt;/i&gt;&lt;span id="textToggleYtPreview"&gt;Tampilkan Video YouTube&lt;/span&gt;
              &lt;/button&gt;
              &lt;button onclick="openMusicAdminModal()" id="btnDrawerAddMusic" class="text-amber-300 hover:underline font-extrabold text-[11px]"&gt;
                &lt;i class="fa-solid fa-plus mr-1"&gt;&lt;/i&gt;Kelola Link YouTube Murotal
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;!-- Daftar Murotal (Render Dinamis) --&gt;
          &lt;div id="playlistItemsContainer" class="grid grid-cols-1 sm:grid-cols-3 gap-2 max-h-48 overflow-y-auto pr-1"&gt;
