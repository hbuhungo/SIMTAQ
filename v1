    function renderMonthlyChart(list) {
      const box = document.getElementById('monthlyBarChart');
      if (!box) return;
      const counts = new Array(12).fill(0);
      list.forEach(item =&amp;amp;gt; {
        const parts = String(item.tanggal || '').split('/');
        if (parts.length === 3) {
          const m = parseInt(parts[1], 10) - 1;
          if (m &amp;amp;gt;= 0 &amp;amp;amp;&amp;amp;amp; m &amp;amp;lt; 12) counts[m]++;
        }
      });
      const maxVal = Math.max(...counts, 4);
      box.innerHTML = counts.map(c =&amp;amp;gt; {
        const h = Math.max(Math.round((c / maxVal) * 100), 8);
        return `&amp;amp;lt;div class="flex-1 flex flex-col items-center justify-end h-full"&amp;amp;gt;
          &amp;amp;lt;span class="text-[9px] font-bold text-slate-500 mb-1"&amp;amp;gt;${c || ''}&amp;amp;lt;/span&amp;amp;gt;
          &amp;amp;lt;div class="w-full max-w-[22px] rounded-t-lg bg-gradient-to-t from-emerald-700 to-sky-500" style="height:${h}%"&amp;amp;gt;&amp;amp;lt;/div&amp;amp;gt;
        &amp;amp;lt;/div&amp;amp;gt;`;
      }).join('');
    }

