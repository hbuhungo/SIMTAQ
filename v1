    function handleLogout() {
      appState.currentUser = null;
      applyUserPermissions();
      setElHTML('authHeaderContainer', `
        &amp;amp;lt;button onclick="openLoginModal()" class="px-3.5 py-2 rounded-xl bg-brand-gradient text-white text-xs font-extrabold shadow-sm hover:opacity-95 transition flex items-center space-x-1.5"&amp;amp;gt;
