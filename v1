      ],
      ustadz: [
        { id: 'UST-01', nip: '198201012005011001', nama: 'Ustadz Ahmad Fauzan, S.Pd.I', lembaga: 'MAN 2 Kab. Gorontalo', halaqah: 'Halaqah Putra 1', kontak: '081234567890', status: 'Aktif' },
        { id: 'UST-02', nip: '198805122015032004', nama: 'Ustadzah Siti Rahmawati, M.Pd.', lembaga: 'Yayasan Abulyatama Indonesia', halaqah: 'Halaqah Putri 1', kontak: '081345678901', status: 'Aktif' }
      ],
      setoran: [
        { id: 'STR-01', tanggal: '24/04/2026', santriId: 'SNT-01', nis: '4334345', santriNama: 'Lutfianiga Lutfiiah', surat: 'Al-Fatihah', ayat: '1-7', juz: 1, nilai: 95, ustadz: 'Ustadzah Siti Rahmawati, M.Pd.', catatan: 'Makhraj dan mad sangat baik.', hasVideo: true, videoBlobUrl: '' },
