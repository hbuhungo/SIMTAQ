        }, 650);
      }
      if (mainAppEl) {
        mainAppEl.classList.remove('hidden');
        mainAppEl.classList.add('fade-in');
      }
    }

    // 2. Memuat Murotal (Deteksi Otomatis Link YouTube vs File MP3)
    function loadTrackByIndex(index, autoPlay = true) {
      if (!appState.playlist.length) return;
      if (index < 0) index = appState.playlist.length - 1;
      if (index >= appState.playlist.length) index = 0;

      audioState.currentIndex = index;
      const track = appState.playlist[index];
      const ytId = extractYouTubeId(track.url);

      setElText('currentTrackTitle', track.title);
      setElText('currentTrackArtist', track.artist || 'Murotal Al-Qur’an SIMTAQ');

      const badgeEl = document.getElementById('currentTrackSourceBadge');
      const btnYtPreview = document.getElementById('btnToggleYtPreview');

      if (ytId) {
        // Mode YouTube Murotal
        audioState.activeMode = 'youtube';
        if (bgMusicEl && !bgMusicEl.paused) bgMusicEl.pause();

        if (badgeEl) {
          badgeEl.innerHTML = '<i class="fa-brands fa-youtube mr-1"></i>YouTube';
          badgeEl.className = 'px-1.5 py-0.2 rounded bg-rose-500/30 border border-rose-400/40 text-[9px] font-black text-rose-200 uppercase shrink-0';
        }
        if (btnYtPreview) btnYtPreview.classList.remove('hidden');

        if (audioState.ytReady && ytPlayerInstance && typeof ytPlayerInstance.loadVideoById === 'function') {
          if (autoPlay) {
            ytPlayerInstance.loadVideoById(ytId);
            ytPlayerInstance.setVolume(audioState.isMuted ? 0 : Math.round(audioState.currentVolume * 100));
            audioState.isPlaying = true;
          } else {
            ytPlayerInstance.cueVideoById(ytId);
            audioState.isPlaying = false;
          }
        } else if (autoPlay) {
          // Jika API YouTube masih sedang dimuat, tunggu sebentar lalu putar
          setTimeout(() => {
            if (audioState.ytReady && ytPlayerInstance) {
              ytPlayerInstance.loadVideoById(ytId);
              ytPlayerInstance.setVolume(audioState.isMuted ? 0 : Math.round(audioState.currentVolume * 100));
            }
          }, 900);
        }
      } else {
        // Mode Audio MP3 Langsung
        audioState.activeMode = 'audio';
        if (audioState.ytReady && ytPlayerInstance && typeof ytPlayerInstance.stopVideo === 'function') {
          ytPlayerInstance.stopVideo();
        }
        if (badgeEl) {
          badgeEl.innerHTML = '<i class="fa-solid fa-book-quran mr-1"></i>MP3';
          badgeEl.className = 'px-1.5 py-0.2 rounded bg-emerald-500/30 border border-emerald-400/40 text-[9px] font-black text-emerald-200 uppercase shrink-0';
        }
        if (btnYtPreview) btnYtPreview.classList.add('hidden');
        document.getElementById('ytWrapperBox')?.classList.replace('yt-visible-frame', 'yt-hidden-frame');

        if (bgMusicEl) {
          bgMusicEl.src = track.url;
          bgMusicEl.load();
          bgMusicEl.volume = audioState.isMuted ? 0 : audioState.currentVolume;
          if (autoPlay) {
            bgMusicEl.play().then(() => {
              audioState.isPlaying = true;
              updateAudioControllerUI();
            }).catch(() => {
              audioState.isPlaying = false;
              updateAudioControllerUI();
            });
          } else {
            audioState.isPlaying = false;
          }
        }
      }

      updateAudioControllerUI();
      renderPlaylistUI();
    }

    function toggleYouTubeMiniVideo() {
      const box = document.getElementById('ytWrapperBox');
      if (!box) return;
      audioState.showYtVideo = !audioState.showYtVideo;
      if (audioState.showYtVideo) {
        box.classList.remove('yt-hidden-frame');
        box.classList.add('yt-visible-frame');
        setElText('textToggleYtPreview', 'Sembunyikan Video YouTube');
      } else {
        box.classList.remove('yt-visible-frame');
        box.classList.add('yt-hidden-frame');
        setElText('textToggleYtPreview', 'Tampilkan Video YouTube');
      }
    }

    function selectTrackFromList(index) {
      loadTrackByIndex(index, true);
    }

    function togglePlayPause() {
      if (!appState.playlist.length) return;

      if (audioState.activeMode === 'youtube') {
        if (!audioState.ytReady || !ytPlayerInstance) {
          showToast('Menyiapkan pemutar YouTube Murotal...', 'info');
          return;
        }
        const st = ytPlayerInstance.getPlayerState();
        if (st === YT.PlayerState.PLAYING) {
          ytPlayerInstance.pauseVideo();
        } else {
          ytPlayerInstance.playVideo();
        }
      } else {
        if (!bgMusicEl) return;
        if (bgMusicEl.paused) {
          bgMusicEl.play().catch(() => {
            showToast('Gagal memuat stream audio, periksa koneksi atau link Murotal.', 'error');
          });
        } else {
          bgMusicEl.pause();
        }
      }
    }

    function nextTrack() {
      if (!appState.playlist.length) return;
      loadTrackByIndex(audioState.currentIndex + 1, true);
    }

    function prevTrack() {
      if (!appState.playlist.length) return;
      loadTrackByIndex(audioState.currentIndex - 1, true);
    }

    // 3. Kontrol Slider Volume (0 - 100) & Mute dengan Memori Volume Sebelumnya
    function handleVolumeChange(val) {
      const numericVal = Math.max(0, Math.min(100, Number(val)));
      const normalized = numericVal / 100;
      audioState.currentVolume = normalized;

      if (numericVal > 0) {
        audioState.previousVolume = normalized;
        audioState.isMuted = false;
      } else {
        audioState.isMuted = true;
      }

      if (bgMusicEl) {
        bgMusicEl.muted = audioState.isMuted;
        bgMusicEl.volume = normalized;
      }
      if (audioState.ytReady && ytPlayerInstance) {
        if (audioState.isMuted) ytPlayerInstance.mute();
        else {
          ytPlayerInstance.unMute();
          ytPlayerInstance.setVolume(numericVal);
        }
      }

      syncVolumeControlsUI(numericVal);
    }

    function toggleMuteAudio() {
      if (!audioState.isMuted) {
        audioState.previousVolume = audioState.currentVolume > 0 ? audioState.currentVolume : 0.75;
        audioState.currentVolume = 0;
        audioState.isMuted = true;

        if (bgMusicEl) {
          bgMusicEl.muted = true;
          bgMusicEl.volume = 0;
        }
        if (audioState.ytReady && ytPlayerInstance) {
          ytPlayerInstance.mute();
          ytPlayerInstance.setVolume(0);
        }
        syncVolumeControlsUI(0);
      } else {
        const restored = audioState.previousVolume > 0 ? audioState.previousVolume : 0.75;
        const percentVal = Math.round(restored * 100);
        audioState.currentVolume = restored;
        audioState.isMuted = false;

        if (bgMusicEl) {
          bgMusicEl.muted = false;
          bgMusicEl.volume = restored;
        }
        if (audioState.ytReady && ytPlayerInstance) {
          ytPlayerInstance.unMute();
          ytPlayerInstance.setVolume(percentVal);
        }
        syncVolumeControlsUI(percentVal);
      }
    }

    function syncVolumeControlsUI(percentVal) {
      const sDesktop = document.getElementById('volumeSlider');
      const sMobile = document.getElementById('volumeSliderMobile');
      if (sDesktop) sDesktop.value = percentVal;
      if (sMobile) sMobile.value = percentVal;

      setElText('volumeValueText', percentVal + '%');
      setElText('volumeValueTextMobile', percentVal + '%');

      const iconMute = document.getElementById('iconMuteStatus');
      const textMute = document.getElementById('textMuteStatus');
      if (iconMute) {
        if (audioState.isMuted || percentVal === 0) {
          iconMute.className = 'fa-solid fa-volume-xmark text-rose-400';
          if (textMute) textMute.textContent = 'Mute';
        } else if (percentVal < 50) {
          iconMute.className = 'fa-solid fa-volume-low text-emerald-300';
          if (textMute) textMute.textContent = 'Suara';
        } else {
          iconMute.className = 'fa-solid fa-volume-high text-emerald-300';
          if (textMute) textMute.textContent = 'Suara';
        }
      }
    }

